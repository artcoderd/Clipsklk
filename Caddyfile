# Single entry point: the web app and the API share one origin, so the session
# cookie is first-party and SSE/uploads go straight to FastAPI (no Next proxy).
# In production put your domain in SITE_ADDRESS (e.g. clipeo.app): Caddy gets the
# HTTPS certificate by itself. Behind Cloudflare (proxied, SSL "Full (strict)") it
# works the same.
{$SITE_ADDRESS::80} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 4GB
	}
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

