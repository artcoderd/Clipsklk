# Production settings for clipeo.us. ops/setup-server.sh copies this to .env and
# fills SECRET_KEY, POSTGRES_PASSWORD, BACKUP_PASSPHRASE and the VAPID keys by itself.
# Fill the rest with: nano .env   (NEVER commit .env, never paste keys into chats)

ENVIRONMENT=production
WEB_URL=https://clipeo.us
SITE_ADDRESS=clipeo.us
SITE_OWNER=
SITE_CONTACT=hola@clipeo.us

SECRET_KEY=__AUTO__
POSTGRES_PASSWORD=__AUTO__

PUBLIC_SIGNUP=false
INVITATION_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
MAX_ACTIVE_JOBS_PER_USER=3
MAX_UPLOAD_MB=4096

# --- Storage: Cloudflare R2 (bucket clipeo-media) ---------------------------------
# Until you fill these, videos are kept on the server's disk (STORAGE_BACKEND=local).
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=clipeo-media
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Video worker (auto: GPU if present, otherwise CPU) ------------------------------
MAX_SOURCE_HOURS=6
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
VIDEO_ENCODER=auto

# --- Live streams -----------------------------------------------------------------------
LIVE_MAX_HOURS=12
LIVE_OFFLINE_GRACE_MINUTES=10
LIVE_MAX_AUTO_CLIPS_PER_HOUR=12
MAX_LIVES_PER_USER=1

# --- Push notifications (filled automatically) -----------------------------------------
VAPID_PUBLIC_KEY=__AUTO__
VAPID_PRIVATE_KEY=__AUTO__
VAPID_SUBJECT=mailto:hola@clipeo.us

# --- AI -----------------------------------------------------------------------------------
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AI_MODEL_ANTHROPIC=claude-opus-5-5
AI_EFFORT=medium

# --- Email (Resend) --------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# SMTP_PASSWORD=                    # your Resend API key
# Must be an address on the domain you verified in Resend:
SMTP_FROM="Clipeo <hola@clipeo.us>"

# --- Payments -----------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WHATSAPP_NUMBER=                  # digits only, with country code

# --- Publishing (when the apps are approved) ------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
TIKTOK_POST_MODE=inbox

# --- Backups -----------------------------------------------------------------------------------------
BACKUP_HOUR=8                       # UTC (8 UTC = 2-3 am in Mexico)
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=__AUTO__
# BACKUP_REMOTE=offsite:clipeo-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
