# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

ENVIRONMENT=development          # production on the real server
WEB_URL=http://localhost:8080    # public URL, used in invitation links (https://clipeo.app)

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=clipeo

# Invitation-only by default. Set to true only if you decide to open sign-ups.
PUBLIC_SIGNUP=false
INVITATION_TTL_DAYS=7

# Abuse protection
LOGIN_MAX_ATTEMPTS=5
MAX_ACTIVE_JOBS_PER_USER=3
MAX_UPLOAD_MB=4096

# Gateway
HTTP_PORT=8080
# SITE_ADDRESS=clipeo.app        # with a real domain Caddy issues HTTPS itself

# --- Storage -------------------------------------------------------------
# local = Docker volume shared by API and worker (one server).
# s3    = Cloudflare R2 / AWS S3 (recommended in production; clips load from the CDN).
STORAGE_BACKEND=local
# S3_BUCKET=clipeo
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Video worker --------------------------------------------------------
MAX_SOURCE_HOURS=6
# auto = large-v3 on GPU, small on CPU. Others: tiny, base, medium, large-v3-turbo
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
# auto = NVENC when a GPU is present, otherwise libx264
VIDEO_ENCODER=auto
# Optional: Netscape cookies file for yt-dlp (helps when YouTube blocks server IPs)
# YTDLP_COOKIES_FILE=/data/models/cookies.txt

# --- Live streams ----------------------------------------------------------
LIVE_MAX_HOURS=12
LIVE_OFFLINE_GRACE_MINUTES=10        # stream down this long = broadcast over
LIVE_MAX_AUTO_CLIPS_PER_HOUR=12
MAX_LIVES_PER_USER=1

# --- Push notifications ----------------------------------------------------
# Generate once with:  docker compose run --rm api python -m app.cli vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- AI clip selection -------------------------------------------------------
# Only the transcript text is sent. Without any key, clips are chosen by the
# non-AI analysis (laughter, screams, volume, chat). Keys are secrets.
AI_PROVIDER=anthropic                # default: anthropic | openai | gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
AI_MODEL_ANTHROPIC=claude-opus-5-5
AI_MODEL_OPENAI=gpt-5
AI_MODEL_GEMINI=gemini-2.5-pro
AI_EFFORT=medium                     # Claude: low | medium | high (more = slower, pricier)
LIVE_AI_REVIEW_MINUTES=5

# --- Publishing ----------------------------------------------------------------
# Meta (Facebook Pages + Instagram): app from developers.facebook.com with Facebook Login.
# Valid OAuth redirect URI: <WEB_URL>/api/social/callback/meta
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# TikTok: app from developers.tiktok.com (Login Kit + Content Posting API).
# Redirect URI: <WEB_URL>/api/social/callback/tiktok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
TIKTOK_POST_MODE=inbox               # inbox (drafts) until TikTok audits the app, then: direct
# TELEGRAM_API_BASE=https://api.telegram.org
# TOKEN_ENCRYPTION_KEY=              # optional Fernet key; derived from SECRET_KEY if unset
